---
import { format, formatDistanceToNow, differenceInHours } from 'date-fns';
import type { Brew, TiltReading } from '../types/brew';

interface Props {
  brew: Brew;
  readings: TiltReading[];
}

const { brew, readings } = Astro.props;
const brewDate = new Date(brew.brew_date);
const latestReading = readings.length > 0 ? readings[readings.length - 1] : null;
const oldestReading = readings.length > 0 ? readings[0] : null;

// Calculate progress
const totalDrop = brew.og - brew.fg;
const currentDrop = latestReading ? brew.og - latestReading.sg : 0;
const progressPercent = totalDrop > 0 ? Math.min(100, Math.round((currentDrop / totalDrop) * 100)) : 0;

// Calculate time fermenting
const hoursFermenting = differenceInHours(new Date(), brewDate);
const daysFermenting = Math.floor(hoursFermenting / 24);
const remainingHours = hoursFermenting % 24;

// Calculate gravity drop rate (points per day)
const getDropRate = () => {
  if (!latestReading || !oldestReading || readings.length < 2) return 0;
  const sgDrop = (oldestReading.sg - latestReading.sg) * 1000; // Convert to points
  const hoursBetween = differenceInHours(new Date(latestReading.timestamp), new Date(oldestReading.timestamp));
  if (hoursBetween === 0) return 0;
  return ((sgDrop / hoursBetween) * 24).toFixed(1);
};

// Temperature trend
const getTempTrend = () => {
  if (readings.length < 10) return 'stable';
  const recent = readings.slice(-10);
  const older = readings.slice(-20, -10);
  if (older.length === 0) return 'stable';
  const recentAvg = recent.reduce((sum, r) => sum + r.temp, 0) / recent.length;
  const olderAvg = older.reduce((sum, r) => sum + r.temp, 0) / older.length;
  if (recentAvg > olderAvg + 0.5) return 'rising';
  if (recentAvg < olderAvg - 0.5) return 'falling';
  return 'stable';
};

const tempTrend = getTempTrend();
const dropRate = getDropRate();

// Estimated ABV so far
const currentAbv = latestReading
  ? ((brew.og - latestReading.sg) * 131.25).toFixed(1)
  : '0.0';
---

<article class="border border-oxidized-copper/50 bg-deep-space overflow-hidden">
  <!-- Header bar -->
  <div class="bg-oxidized-copper/10 border-b border-oxidized-copper/30 px-6 py-3 flex items-center justify-between">
    <div class="flex items-center gap-3">
      <div class="w-2 h-2 bg-oxidized-copper rounded-full animate-pulse"></div>
      <span class="font-mono text-xs text-oxidized-copper uppercase tracking-wider">Vessel Active</span>
    </div>
    <span class="font-mono text-xs text-stardust/40">
      {format(brewDate, 'MMM d, yyyy')} — Day {daysFermenting + 1}
    </span>
  </div>

  <div class="p-6">
    <!-- Main telemetry grid -->
    {latestReading ? (
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
        <!-- Current Gravity -->
        <div class="border border-art-deco-brass/20 bg-void-black p-4 relative overflow-hidden">
          <div class="absolute top-0 right-0 w-16 h-16 bg-oxidized-copper/5 rounded-full -translate-y-1/2 translate-x-1/2"></div>
          <p class="font-mono text-[10px] text-stardust/40 uppercase tracking-wider mb-1">Gravity</p>
          <p class="font-mono text-3xl text-oxidized-copper tabular-nums telemetry-value" data-value={latestReading.sg.toFixed(3)} data-decimals="3">{latestReading.sg.toFixed(3)}</p>
          <p class="font-mono text-[10px] text-stardust/30 mt-1">Target: {brew.fg.toFixed(3)}</p>
        </div>

        <!-- Temperature -->
        <div class="border border-art-deco-brass/20 bg-void-black p-4 relative overflow-hidden">
          <div class="absolute top-0 right-0 w-16 h-16 bg-art-deco-brass/5 rounded-full -translate-y-1/2 translate-x-1/2"></div>
          <p class="font-mono text-[10px] text-stardust/40 uppercase tracking-wider mb-1">Temperature</p>
          <div class="flex items-baseline gap-1">
            <p class="font-mono text-3xl text-art-deco-brass tabular-nums telemetry-value" data-value={latestReading.temp.toFixed(1)} data-decimals="1">{latestReading.temp.toFixed(1)}</p>
            <span class="font-mono text-lg text-art-deco-brass/60">°F</span>
          </div>
          <p class="font-mono text-[10px] text-stardust/30 mt-1 flex items-center gap-1">
            {tempTrend === 'rising' && <span class="text-nebula-red">↑</span>}
            {tempTrend === 'falling' && <span class="text-oxidized-copper">↓</span>}
            {tempTrend === 'stable' && <span class="text-stardust/50">→</span>}
            {tempTrend}
          </p>
        </div>

        <!-- Current ABV -->
        <div class="border border-art-deco-brass/20 bg-void-black p-4 relative overflow-hidden">
          <div class="absolute top-0 right-0 w-16 h-16 bg-stardust/5 rounded-full -translate-y-1/2 translate-x-1/2"></div>
          <p class="font-mono text-[10px] text-stardust/40 uppercase tracking-wider mb-1">Current ABV</p>
          <div class="flex items-baseline gap-1">
            <p class="font-mono text-3xl text-stardust tabular-nums telemetry-value" data-value={currentAbv} data-decimals="1">{currentAbv}</p>
            <span class="font-mono text-lg text-stardust/60">%</span>
          </div>
          <p class="font-mono text-[10px] text-stardust/30 mt-1">Est. Final: {brew.abv}%</p>
        </div>

        <!-- Drop Rate -->
        <div class="border border-art-deco-brass/20 bg-void-black p-4 relative overflow-hidden">
          <div class="absolute top-0 right-0 w-16 h-16 bg-oxidized-copper/5 rounded-full -translate-y-1/2 translate-x-1/2"></div>
          <p class="font-mono text-[10px] text-stardust/40 uppercase tracking-wider mb-1">Drop Rate</p>
          <div class="flex items-baseline gap-1">
            <p class="font-mono text-3xl text-oxidized-copper tabular-nums telemetry-value" data-value={dropRate} data-decimals="1">{dropRate}</p>
            <span class="font-mono text-xs text-stardust/40">pts/day</span>
          </div>
          <p class="font-mono text-[10px] text-stardust/30 mt-1">
            {Number(dropRate) > 5 ? 'Active' : Number(dropRate) > 1 ? 'Slowing' : 'Near Complete'}
          </p>
        </div>
      </div>
    ) : (
      <div class="text-center py-8 border border-stardust/10 mb-6">
        <p class="font-mono text-stardust/40 text-sm">Awaiting telemetry data...</p>
      </div>
    )}

    <!-- Progress bar -->
    <div class="mb-6">
      <div class="flex justify-between items-center mb-2">
        <span class="font-mono text-[10px] text-stardust/40 uppercase tracking-wider">Attenuation Progress</span>
        <span class="font-mono text-sm text-art-deco-brass telemetry-value" data-value={progressPercent} data-decimals="0">{progressPercent}%</span>
      </div>
      <!-- Tank container -->
      <div class="h-5 bg-void-black border border-art-deco-brass/20 relative overflow-hidden">
        <!-- Progress markers (behind liquid) -->
        <div class="absolute inset-0 flex pointer-events-none z-0">
          {[25, 50, 75].map(mark => (
            <div class="flex-1 border-r border-stardust/10 last:border-r-0"></div>
          ))}
        </div>
        <!-- Liquid fill with wave animation -->
        <div
          class="absolute bottom-0 left-0 h-full bg-gradient-to-t from-oxidized-copper via-oxidized-copper to-art-deco-brass transition-all duration-1000 liquid-fill"
          style={`width: ${progressPercent}%`}
        >
          <!-- Shimmer highlight -->
          <div class="liquid-shine"></div>
          <!-- Bubble particles -->
          <div class="absolute bottom-0 left-1/4 w-1 h-1 bg-white/20 rounded-full bubble" style="--duration: 2.5s; --delay: 0s;"></div>
          <div class="absolute bottom-0 left-1/2 w-0.5 h-0.5 bg-white/15 rounded-full bubble" style="--duration: 3s; --delay: 0.8s;"></div>
          <div class="absolute bottom-0 left-3/4 w-1 h-1 bg-white/20 rounded-full bubble" style="--duration: 2.8s; --delay: 1.5s;"></div>
          <div class="absolute bottom-1 left-[15%] w-0.5 h-0.5 bg-white/10 rounded-full bubble" style="--duration: 3.2s; --delay: 0.3s;"></div>
          <div class="absolute bottom-0 left-[60%] w-1 h-1 bg-white/15 rounded-full bubble" style="--duration: 2.6s; --delay: 1.2s;"></div>
        </div>
      </div>
      <div class="flex justify-between mt-1">
        <span class="font-mono text-[10px] text-stardust/30">OG {brew.og.toFixed(3)}</span>
        <span class="font-mono text-[10px] text-stardust/30">FG {brew.fg.toFixed(3)}</span>
      </div>
    </div>

    <!-- Bottom stats row -->
    <div class="grid grid-cols-4 gap-4 pt-4 border-t border-art-deco-brass/20">
      <div class="text-center">
        <p class="font-mono text-[10px] text-stardust/40 uppercase">OG</p>
        <p class="font-mono text-sm text-stardust">{brew.og.toFixed(3)}</p>
      </div>
      <div class="text-center">
        <p class="font-mono text-[10px] text-stardust/40 uppercase">Target FG</p>
        <p class="font-mono text-sm text-stardust">{brew.fg.toFixed(3)}</p>
      </div>
      <div class="text-center">
        <p class="font-mono text-[10px] text-stardust/40 uppercase">Target ABV</p>
        <p class="font-mono text-sm text-stardust">{brew.abv}%</p>
      </div>
      <div class="text-center">
        <p class="font-mono text-[10px] text-stardust/40 uppercase">Duration</p>
        <p class="font-mono text-sm text-stardust">{daysFermenting}d {remainingHours}h</p>
      </div>
    </div>

    <!-- Last update timestamp -->
    {latestReading && (
      <p class="font-mono text-[10px] text-stardust/30 text-center mt-4">
        Last reading: {format(new Date(latestReading.timestamp), 'MMM d, h:mm a')}
      </p>
    )}
  </div>
</article>

<script>
  // Text scramble effect for telemetry values
  function scrambleValue(element: HTMLElement) {
    const finalValue = element.dataset.value || element.textContent || '';
    const decimals = parseInt(element.dataset.decimals || '0', 10);
    const isPercentage = element.textContent?.includes('%');
    const duration = 800; // Total animation duration in ms
    const interval = 50; // Update interval in ms
    const iterations = duration / interval;

    let currentIteration = 0;
    element.setAttribute('data-scrambling', 'true');

    const scrambleInterval = setInterval(() => {
      currentIteration++;

      // Generate random number with same format as final value
      const numValue = parseFloat(finalValue);
      const variance = numValue * 0.3; // 30% variance
      const randomValue = numValue + (Math.random() - 0.5) * variance * 2;
      const displayValue = randomValue.toFixed(decimals);

      element.textContent = isPercentage ? `${displayValue}%` : displayValue;

      if (currentIteration >= iterations) {
        clearInterval(scrambleInterval);
        element.textContent = isPercentage ? `${finalValue}%` : finalValue;
        element.removeAttribute('data-scrambling');
      }
    }, interval);
  }

  // Run scramble effect on page load
  function initScramble() {
    const telemetryValues = document.querySelectorAll('.telemetry-value');
    telemetryValues.forEach((el, index) => {
      // Stagger the start of each scramble
      setTimeout(() => {
        scrambleValue(el as HTMLElement);
      }, index * 100);
    });
  }

  // Run on initial load
  document.addEventListener('DOMContentLoaded', initScramble);

  // Run on Astro view transitions
  document.addEventListener('astro:page-load', initScramble);
</script>
