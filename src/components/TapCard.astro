---
import { formatDistanceToNow, parseISO } from 'date-fns';
import type { Brew } from '../types/brew';
import { getDaysOld, getFreshnessLabel, getScarcityLevel } from '../utils/brewCalculations';

interface Props {
  brew: Brew;
  index?: number;
  variant?: 'default' | 'tv';
}

const { brew, index = 0, variant = 'default' } = Astro.props;
const isTV = variant === 'tv';
const isKicked = brew.status === 'Kicked';

// Calculate freshness using shared utilities
const brewDate = parseISO(brew.brew_date);
const daysOld = getDaysOld(brew.brew_date);
const freshness = formatDistanceToNow(brewDate, { addSuffix: true });
const freshnessLabel = getFreshnessLabel(daysOld);
const scarcity = getScarcityLevel(daysOld, isKicked);
const isRunningLow = scarcity <= 25 && !isKicked;
---

<article
  class:list={[
    'relative border bg-deep-space flex flex-col overflow-hidden h-full',
    isTV ? 'p-6 lg:p-8 gap-3 lg:gap-4' : 'group p-6 gap-4 transition-all duration-300 animate-fade-up',
    isKicked
      ? isTV ? 'border-nebula-red/50 opacity-50' : 'border-nebula-red/50 opacity-60'
      : isTV ? 'border-art-deco-brass/60' : 'border-art-deco-brass/60 hover:border-art-deco-brass hover:brass-glow',
  ]}
  style={isTV ? undefined : `animation-delay: ${index * 100}ms`}
>
  <!-- Batch number watermark -->
  <span class:list={[
    'absolute font-mono font-bold text-art-deco-brass/5 select-none',
    isTV ? '-right-2 -top-4 text-7xl lg:text-9xl' : '-right-2 -top-2 text-6xl'
  ]}>
    {brew.id.split('-')[1]}
  </span>

  <!-- Header with name and ABV -->
  <div class="flex justify-between items-start gap-4">
    <div class="flex-1 min-w-0">
      <span class:list={[
        'font-mono text-art-deco-brass/60 tracking-wider',
        isTV ? 'text-xs lg:text-sm' : 'text-[10px]'
      ]}>
        BATCH {brew.id}
      </span>
      {isTV ? (
        <h2
          class:list={[
            'font-sans uppercase font-semibold tracking-widest leading-tight mt-1',
            isTV ? 'text-xl lg:text-3xl xl:text-4xl' : '',
            isKicked ? 'text-nebula-red line-through decoration-2' : 'text-stardust',
          ]}
        >
          {brew.name}
        </h2>
      ) : (
        <h3
          class:list={[
            'font-sans uppercase font-semibold text-lg tracking-widest leading-tight mt-1 line-clamp-2 min-h-[2.5rem]',
            isKicked ? 'text-nebula-red line-through decoration-1' : 'text-stardust group-hover:text-art-deco-brass transition-colors',
          ]}
        >
          {brew.name}
        </h3>
      )}
    </div>
    <div class="text-right shrink-0">
      <span class:list={[
        'font-mono text-art-deco-brass font-bold',
        isTV ? 'text-3xl lg:text-5xl' : 'text-xl'
      ]}>{brew.abv}</span>
      <span class:list={[
        'font-mono text-stardust/50',
        isTV ? 'text-sm lg:text-lg' : 'text-xs'
      ]}>%</span>
    </div>
  </div>

  <!-- Style -->
  <p class:list={[
    'font-mono text-stardust/75',
    isTV ? 'text-base lg:text-xl' : 'text-sm'
  ]}>{brew.style}</p>

  <!-- Stats row -->
  <div class:list={[
    'flex font-mono',
    isTV ? 'gap-4 lg:gap-6 text-sm lg:text-base' : 'gap-4 text-xs'
  ]}>
    {brew.ibu > 0 && (
      <span class="text-oxidized-copper">{brew.ibu} IBU</span>
    )}
    {brew.og && (
      <span class="text-stardust/50">OG {brew.og.toFixed(3)}</span>
    )}
  </div>

  <!-- Bottom section -->
  <div class:list={[
    'mt-auto border-t border-stardust/10',
    isTV ? 'pt-4 lg:pt-6' : 'pt-4'
  ]}>
    {isKicked ? (
      <div class:list={['flex items-center', isTV ? 'gap-3' : 'gap-2']}>
        <span class:list={[
          'inline-block bg-nebula-red rounded-full',
          isTV ? 'w-3 h-3 lg:w-4 lg:h-4' : 'w-2 h-2'
        ]}></span>
        <span class:list={[
          'font-mono text-nebula-red uppercase tracking-wider',
          isTV ? 'text-sm lg:text-lg' : 'text-xs'
        ]}>Kicked</span>
      </div>
    ) : (
      <div class="flex items-center justify-between">
        <div class:list={['flex items-center', isTV ? 'gap-3' : 'gap-2']}>
          <span class:list={[
            'inline-block rounded-full',
            isTV ? 'w-3 h-3 lg:w-4 lg:h-4' : 'w-2 h-2',
            isRunningLow ? 'bg-nebula-red animate-pulse' : 'bg-oxidized-copper'
          ]}></span>
          <span class:list={[
            'font-mono uppercase tracking-wider',
            isTV ? 'text-xs lg:text-base' : 'text-[10px]',
            isRunningLow ? 'text-nebula-red' : 'text-stardust/50'
          ]}>
            {isRunningLow ? 'Running Low' : freshnessLabel}
          </span>
        </div>
        <!-- Keg level indicator -->
        <div class:list={['flex items-center', isTV ? 'gap-3' : 'gap-2']}>
          <div class:list={[
            'bg-stardust/10 overflow-hidden',
            isTV ? 'w-20 lg:w-32 h-2 lg:h-3' : 'w-16 h-1'
          ]}>
            <div
              class:list={[
                'h-full',
                !isTV && 'transition-all duration-500',
                isRunningLow ? 'bg-nebula-red' : 'bg-oxidized-copper'
              ]}
              style={`width: ${scarcity}%`}
            ></div>
          </div>
          <span class:list={[
            'font-mono text-stardust/40',
            isTV ? 'text-xs lg:text-sm' : 'text-[10px]'
          ]}>{scarcity}%</span>
        </div>
      </div>
    )}
  </div>

  <!-- Corner accent (default variant only) -->
  {!isTV && (
    <div class="absolute bottom-0 right-0 w-8 h-8 border-b border-r border-art-deco-brass/20 opacity-0 group-hover:opacity-100 transition-opacity"></div>
  )}
</article>
