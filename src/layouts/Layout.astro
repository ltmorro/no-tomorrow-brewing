---
import { ClientRouter } from 'astro:transitions';
import '../styles/globals.css';
import Header from '../components/Header.astro';

interface Props {
	title: string;
	description?: string;
}

const { title, description = 'Small-batch, experimental homebrewery. Brew every beer like it\'s your last.' } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#0D0D0D" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="canonical" href={canonicalURL} />
		<meta name="generator" content={Astro.generator} />

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:site_name" content="No Tomorrow Brewing" />

		<!-- Fonts - preconnect and preload for performance -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="preload" href="https://fonts.googleapis.com/css2?family=Josefin+Sans:wght@300;600&family=Space+Mono:wght@400;700&display=swap" as="style" />
		<link href="https://fonts.googleapis.com/css2?family=Josefin+Sans:wght@300;600&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />

		<title>{title}</title>
		<ClientRouter />
	</head>
	<body class="min-h-screen">
		<!-- Film grain overlay for lo-fi aesthetic -->
		<div class="noise-overlay" aria-hidden="true"></div>
		<Header />
		<slot />
	</body>
</html>
