---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 - No Tomorrow Brewing">
  <main class="min-h-[80vh] flex flex-col items-center justify-center px-8 py-20">

    <!-- Glitchy 404 display -->
    <div class="relative mb-8">
      <span class="font-mono text-[12rem] md:text-[16rem] font-bold text-art-deco-brass/10 leading-none select-none">
        404
      </span>
      <div class="absolute inset-0 flex items-center justify-center">
        <span class="font-mono text-6xl md:text-8xl font-bold text-art-deco-brass">
          404
        </span>
      </div>
    </div>

    <!-- Message -->
    <h1 class="font-sans uppercase font-semibold text-2xl md:text-3xl tracking-widest text-stardust text-center mb-4">
      Keg Not Found
    </h1>

    <p class="font-mono text-stardust/50 text-center max-w-md mb-8">
      Looks like this batch was kicked before you got here.
      The page you're looking for doesn't exist or has been moved.
    </p>

    <!-- Decorative divider -->
    <div class="flex items-center gap-4 mb-8">
      <div class="w-8 h-px art-deco-line"></div>
      <div class="w-2 h-2 border border-art-deco-brass/50 rotate-45"></div>
      <div class="w-8 h-px art-deco-line"></div>
    </div>

    <!-- Navigation options -->
    <div class="flex flex-col sm:flex-row gap-4">
      <a
        href="/"
        class="font-mono text-sm px-6 py-3 border border-art-deco-brass text-art-deco-brass hover:bg-art-deco-brass hover:text-void-black transition-colors text-center"
      >
        Back to Taproom
      </a>
      <a
        href="/library"
        class="font-mono text-sm px-6 py-3 border border-stardust/30 text-stardust/70 hover:border-stardust hover:text-stardust transition-colors text-center"
      >
        Browse Library
      </a>
    </div>

  </main>
</Layout>
