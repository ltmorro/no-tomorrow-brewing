---
import Layout from '../layouts/Layout.astro';
import VibeCheck from '../components/VibeCheck';
import LibraryBrowser from '../components/LibraryBrowser';
import { fetchBrews, getBrewsByStatus } from '../utils/googleSheets';

const brews = await fetchBrews();
const archive = getBrewsByStatus(brews, 'Archive');
const onTap = getBrewsByStatus(brews, 'On Tap');

// Combine On Tap and Archive brews for the library
const libraryBrews = [...onTap, ...archive];

// Sort by brew date descending
libraryBrews.sort((a, b) => new Date(b.brew_date).getTime() - new Date(a.brew_date).getTime());

// NOTE: Fermentation data is now fetched lazily on the client when a user opens a beer modal.
// This avoids N+1 requests at build time that would cause rate limiting with many brews.

// Get featured brew with spotify embed
const featuredBrew = libraryBrews.find(b => b.spotify_id);

// Calculate library stats
const totalGallons = brews.length * 5; // Assuming 5 gallon batches
const avgOg = libraryBrews.length > 0 ? (libraryBrews.reduce((sum, b) => sum + b.og, 0) / libraryBrews.length) : 0;
const avgAttenuation = libraryBrews.length > 0
  ? Math.round(libraryBrews.reduce((sum, b) => sum + ((b.og - b.fg) / (b.og - 1)) * 100, 0) / libraryBrews.length)
  : 0;

// Style breakdown
const styleCount = brews.reduce((acc, brew) => {
  const baseStyle = brew.style.split(' ').slice(-1)[0]; // Get last word (IPA, Stout, etc.)
  acc[baseStyle] = (acc[baseStyle] || 0) + 1;
  return acc;
}, {} as Record<string, number>);

const topStyles = Object.entries(styleCount)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 4);
---

<Layout title="The Library - No Tomorrow Brewing">
  <main class="relative min-h-screen">

    <!-- HERO HEADER -->
    <section class="relative border-b border-art-deco-brass/30 bg-deep-space overflow-hidden">
      <!-- Decorative bookshelf lines -->
      <div class="absolute inset-0 pointer-events-none opacity-5">
        {[...Array(8)].map((_, i) => (
          <div class="h-px bg-art-deco-brass" style={`margin-top: ${(i + 1) * 12}%`}></div>
        ))}
      </div>

      <div class="max-w-6xl mx-auto px-8 py-16 relative">
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-8">
          <div>
            <div class="flex items-center gap-3 mb-3">
              <div class="w-8 h-px bg-art-deco-brass/50"></div>
              <span class="font-mono text-[10px] text-art-deco-brass/70 uppercase tracking-widest">Est. 2025</span>
            </div>
            <h1 class="font-sans uppercase font-semibold text-4xl md:text-5xl tracking-widest text-stardust mb-3">
              The Library
            </h1>
            <p class="font-mono text-stardust/50 max-w-md text-sm leading-relaxed">
              A historical archive of recipes and brew day records. Every batch tells a story—these are the chapters we've written.
            </p>
          </div>

          <!-- Quick stats -->
          <div class="flex gap-6">
            <div class="text-center">
              <p class="font-mono text-3xl text-art-deco-brass">{brews.length}</p>
              <p class="font-mono text-[10px] text-stardust/40 uppercase tracking-wider">Total Batches</p>
            </div>
            <div class="w-px bg-stardust/10"></div>
            <div class="text-center">
              <p class="font-mono text-3xl text-oxidized-copper">{libraryBrews.length}</p>
              <p class="font-mono text-[10px] text-stardust/40 uppercase tracking-wider">In Library</p>
            </div>
            <div class="w-px bg-stardust/10"></div>
            <div class="text-center">
              <p class="font-mono text-3xl text-stardust">{totalGallons}</p>
              <p class="font-mono text-[10px] text-stardust/40 uppercase tracking-wider">Gallons</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- STATS DASHBOARD -->
    <section class="border-b border-art-deco-brass/20 bg-void-black/50">
      <div class="max-w-6xl mx-auto px-8 py-8">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
          <!-- Avg OG -->
          <div class="text-center p-4 border border-art-deco-brass/10 bg-deep-space/50">
            <p class="font-mono text-2xl text-oxidized-copper tabular-nums">{avgOg.toFixed(3)}</p>
            <p class="font-mono text-[10px] text-stardust/40 uppercase tracking-wider mt-1">Avg OG</p>
          </div>
          <!-- Avg ABV -->
          <div class="text-center p-4 border border-art-deco-brass/10 bg-deep-space/50">
            <p class="font-mono text-2xl text-art-deco-brass tabular-nums">
              {libraryBrews.length > 0 ? (libraryBrews.reduce((sum, b) => sum + b.abv, 0) / libraryBrews.length).toFixed(1) : '0'}%
            </p>
            <p class="font-mono text-[10px] text-stardust/40 uppercase tracking-wider mt-1">Avg ABV</p>
          </div>
          <!-- Avg IBU -->
          <div class="text-center p-4 border border-art-deco-brass/10 bg-deep-space/50">
            <p class="font-mono text-2xl text-stardust tabular-nums">
              {libraryBrews.length > 0 ? Math.round(libraryBrews.reduce((sum, b) => sum + b.ibu, 0) / libraryBrews.length) : '0'}
            </p>
            <p class="font-mono text-[10px] text-stardust/40 uppercase tracking-wider mt-1">Avg IBU</p>
          </div>
          <!-- Avg Attenuation -->
          <div class="text-center p-4 border border-art-deco-brass/10 bg-deep-space/50">
            <p class="font-mono text-2xl text-oxidized-copper tabular-nums">{avgAttenuation}%</p>
            <p class="font-mono text-[10px] text-stardust/40 uppercase tracking-wider mt-1">Avg Atten.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- STYLE BREAKDOWN -->
    {topStyles.length > 0 && (
      <section class="border-b border-art-deco-brass/20">
        <div class="max-w-6xl mx-auto px-8 py-8">
          <div class="flex items-center gap-4 mb-6">
            <span class="font-mono text-[10px] text-stardust/40 uppercase tracking-widest">Style Distribution</span>
            <div class="h-px flex-1 art-deco-line"></div>
          </div>
          <div class="flex flex-wrap gap-4">
            {topStyles.map(([style, count]) => (
              <div class="flex items-center gap-3 px-4 py-2 border border-art-deco-brass/20 bg-deep-space/30">
                <span class="font-mono text-sm text-stardust">{style}</span>
                <span class="font-mono text-xs text-art-deco-brass bg-art-deco-brass/10 px-2 py-0.5">{count}</span>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- SONIC TERROIR -->
    {featuredBrew && featuredBrew.spotify_id && (
      <section class="border-b border-art-deco-brass/20 bg-deep-space/30">
        <div class="max-w-4xl mx-auto px-8 py-12">
          <div class="flex flex-col md:flex-row items-center gap-8">
            <div class="flex-1">
              <div class="flex items-center gap-3 mb-3">
                <div class="w-6 h-px bg-art-deco-brass/50"></div>
                <span class="font-mono text-[10px] text-stardust/40 uppercase tracking-widest">From The Vault</span>
              </div>
              <h3 class="font-sans uppercase font-semibold text-xl tracking-widest text-art-deco-brass mb-3">
                Sonic Terroir
              </h3>
              <p class="font-mono text-sm text-stardust/50 leading-relaxed">
                The soundtrack that shaped <span class="text-stardust">{featuredBrew.name}</span>.
                Every brew day has a vibe—this one's preserved in the archives.
              </p>
            </div>
            <div class="flex-1 w-full max-w-sm">
              <div class="border border-art-deco-brass/20 bg-void-black p-4">
                <VibeCheck spotifyId={featuredBrew.spotify_id} client:load />
              </div>
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- ARCHIVE BROWSER -->
    <section class="max-w-6xl mx-auto px-8 py-16">
      <LibraryBrowser brews={libraryBrews} client:load />
    </section>

    <!-- FOOTER DECORATION -->
    <div class="flex items-center justify-center py-12">
      <div class="flex items-center gap-4">
        <div class="w-12 h-px art-deco-line"></div>
        <div class="w-2 h-2 border border-art-deco-brass/50 rotate-45"></div>
        <span class="font-mono text-[10px] text-stardust/20 uppercase tracking-widest">End of Archives</span>
        <div class="w-2 h-2 border border-art-deco-brass/50 rotate-45"></div>
        <div class="w-12 h-px art-deco-line"></div>
      </div>
    </div>

  </main>
</Layout>
