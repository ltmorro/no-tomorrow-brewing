---
import '../styles/globals.css';
import TvDashboard from '../components/TvDashboard';
import logo from '../assets/no-tomorrow-logo.svg';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0D0D0D" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="robots" content="noindex" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Josefin+Sans:wght@300;600&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />

    <title>Taplist | No Tomorrow Brewing</title>
  </head>
  <body class="min-h-screen overflow-hidden">
    <!-- Film grain overlay -->
    <div class="noise-overlay" aria-hidden="true"></div>

    <main class="h-screen">
      <TvDashboard client:only="react" logoUrl={logo.src} />
    </main>
  </body>
</html>
