---
import { Image } from 'astro:assets';
import '../styles/globals.css';
import logo from '../assets/no-tomorrow-logo.svg';
import { fetchBrews, getBrewsByStatus } from '../utils/googleSheets';

const brews = await fetchBrews();
const onTap = getBrewsByStatus(brews, 'On Tap');
const kicked = getBrewsByStatus(brews, 'Kicked');
const tapList = [...onTap, ...kicked];

// Helpers for display
import { formatDistanceToNow, differenceInDays, parseISO } from 'date-fns';

const now = new Date();

const getFreshnessLabel = (daysOld: number) => {
  if (daysOld <= 7) return 'PEAK FRESH';
  if (daysOld <= 14) return 'DRINKING WELL';
  if (daysOld <= 30) return 'MATURE';
  return 'AGED';
};

const getScarcityLevel = (daysOld: number, isKicked: boolean) => {
  if (isKicked) return 0;
  if (daysOld <= 3) return 95;
  if (daysOld <= 7) return 75;
  if (daysOld <= 14) return 50;
  if (daysOld <= 21) return 25;
  return 10;
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0D0D0D" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="robots" content="noindex" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Josefin+Sans:wght@300;600&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />

    <title>Taplist | No Tomorrow Brewing</title>

    <!-- Auto-refresh every 5 minutes -->
    <meta http-equiv="refresh" content="300" />
  </head>
  <body class="min-h-screen overflow-hidden">
    <!-- Film grain overlay -->
    <div class="noise-overlay" aria-hidden="true"></div>

    <main class="h-screen flex flex-col p-6 lg:p-8">
      <!-- Compact header -->
      <header class="flex items-center justify-between mb-6 lg:mb-8 shrink-0">
        <div class="flex items-center gap-4 lg:gap-6">
          <Image
            src={logo}
            alt="No Tomorrow Brewing"
            width="80"
            class="lg:w-24"
          />
          <div>
            <h1 class="font-sans uppercase font-semibold text-2xl lg:text-4xl tracking-widest text-stardust">
              On Tap
            </h1>
            <p class="font-mono text-xs lg:text-sm text-stardust/40 uppercase tracking-wider">
              {tapList.filter(b => b.status !== 'Kicked').length} Pouring
            </p>
          </div>
        </div>

        <!-- Live indicator -->
        <div class="flex items-center gap-3">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 lg:w-3 lg:h-3 bg-oxidized-copper rounded-full animate-pulse"></span>
            <span class="font-mono text-xs lg:text-sm text-stardust/50 uppercase tracking-wider hidden sm:inline">Live</span>
          </div>
        </div>
      </header>

      <!-- Tap grid - maximized -->
      <div class="flex-1 min-h-0">
        {tapList.length > 0 ? (
          <div class:list={[
            'grid gap-4 lg:gap-6 h-full auto-rows-fr',
            tapList.length <= 2 && 'grid-cols-1 md:grid-cols-2',
            tapList.length === 3 && 'grid-cols-1 md:grid-cols-3',
            tapList.length === 4 && 'grid-cols-2',
            tapList.length >= 5 && tapList.length <= 6 && 'grid-cols-2 md:grid-cols-3',
            tapList.length > 6 && 'grid-cols-2 md:grid-cols-3 lg:grid-cols-4',
          ]}>
            {tapList.map((brew) => {
              const isKicked = brew.status === 'Kicked';
              const brewDate = parseISO(brew.brew_date);
              const daysOld = differenceInDays(now, brewDate);
              const scarcity = getScarcityLevel(daysOld, isKicked);
              const isRunningLow = scarcity <= 25 && !isKicked;

              return (
                <article
                  class:list={[
                    'relative border bg-deep-space p-6 lg:p-8 flex flex-col gap-3 lg:gap-4 overflow-hidden',
                    isKicked
                      ? 'border-nebula-red/50 opacity-50'
                      : 'border-art-deco-brass/60',
                  ]}
                >
                  <!-- Batch watermark -->
                  <span class="absolute -right-2 -top-4 font-mono text-7xl lg:text-9xl font-bold text-art-deco-brass/5 select-none">
                    {brew.id.split('-')[1]}
                  </span>

                  <!-- Header -->
                  <div class="flex justify-between items-start gap-4">
                    <div class="flex-1 min-w-0">
                      <span class="font-mono text-xs lg:text-sm text-art-deco-brass/60 tracking-wider">
                        BATCH {brew.id}
                      </span>
                      <h2
                        class:list={[
                          'font-sans uppercase font-semibold text-xl lg:text-3xl xl:text-4xl tracking-widest leading-tight mt-1',
                          isKicked ? 'text-nebula-red line-through decoration-2' : 'text-stardust',
                        ]}
                      >
                        {brew.name}
                      </h2>
                    </div>
                    <div class="text-right shrink-0">
                      <span class="font-mono text-3xl lg:text-5xl text-art-deco-brass font-bold">{brew.abv}</span>
                      <span class="font-mono text-sm lg:text-lg text-stardust/50">%</span>
                    </div>
                  </div>

                  <!-- Style -->
                  <p class="font-mono text-base lg:text-xl text-stardust/75">{brew.style}</p>

                  <!-- Stats -->
                  <div class="flex gap-4 lg:gap-6 text-sm lg:text-base font-mono">
                    {brew.ibu > 0 && (
                      <span class="text-oxidized-copper">{brew.ibu} IBU</span>
                    )}
                    {brew.og && (
                      <span class="text-stardust/50">OG {brew.og.toFixed(3)}</span>
                    )}
                  </div>

                  <!-- Status bar -->
                  <div class="mt-auto pt-4 lg:pt-6 border-t border-stardust/10">
                    {isKicked ? (
                      <div class="flex items-center gap-3">
                        <span class="inline-block w-3 h-3 lg:w-4 lg:h-4 bg-nebula-red rounded-full"></span>
                        <span class="font-mono text-sm lg:text-lg text-nebula-red uppercase tracking-wider">Kicked</span>
                      </div>
                    ) : (
                      <div class="flex items-center justify-between">
                        <div class="flex items-center gap-3">
                          <span class:list={[
                            'inline-block w-3 h-3 lg:w-4 lg:h-4 rounded-full',
                            isRunningLow ? 'bg-nebula-red animate-pulse' : 'bg-oxidized-copper'
                          ]}></span>
                          <span class:list={[
                            'font-mono text-xs lg:text-base uppercase tracking-wider',
                            isRunningLow ? 'text-nebula-red' : 'text-stardust/50'
                          ]}>
                            {isRunningLow ? 'Running Low' : getFreshnessLabel(daysOld)}
                          </span>
                        </div>
                        <!-- Keg level -->
                        <div class="flex items-center gap-3">
                          <div class="w-20 lg:w-32 h-2 lg:h-3 bg-stardust/10 overflow-hidden">
                            <div
                              class:list={[
                                'h-full',
                                isRunningLow ? 'bg-nebula-red' : 'bg-oxidized-copper'
                              ]}
                              style={`width: ${scarcity}%`}
                            ></div>
                          </div>
                          <span class="font-mono text-xs lg:text-sm text-stardust/40">{scarcity}%</span>
                        </div>
                      </div>
                    )}
                  </div>
                </article>
              );
            })}
          </div>
        ) : (
          <div class="h-full flex items-center justify-center border border-stardust/10">
            <p class="font-mono text-xl lg:text-2xl text-stardust/50">
              Kegs are dry. Something's brewing.
            </p>
          </div>
        )}
      </div>

      <!-- Footer timestamp -->
      <footer class="shrink-0 mt-4 lg:mt-6 flex items-center justify-between text-stardust/30">
        <span class="font-mono text-xs lg:text-sm">notomorrowbrewing.co</span>
        <span class="font-mono text-xs lg:text-sm">
          Updated {now.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' })}
        </span>
      </footer>
    </main>
  </body>
</html>
